# macOS overrides for the shared Ghostty config (matches ~/.config/alacritty-local.toml)

font-size = 12

# Launches from the Dock or Finder start in /, so start in the home directory.
# New tabs and splits still inherit the current directory.
working-directory = home

# Transparent titlebar that keeps the close/minimize/zoom buttons. A blank
# title hides the title text (an empty value would restore the default).
window-decoration = auto
macos-titlebar-style = transparent
title = " "
macos-titlebar-proxy-icon = hidden

# Keep the bell out of the titlebar (the shared config adds a bell emoji to
# the title); the dock icon still bounces when Ghostty is unfocused.
bell-features = no-system,no-audio,attention,no-title,no-border

# Catppuccin Mocha
# https://github.com/catppuccin/alacritty
